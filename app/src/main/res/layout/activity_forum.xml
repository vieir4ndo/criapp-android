<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_purple_to_holo_purple_background"
    tools:context=".ForumActivity">
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:src="@drawable/forum"
        app:layout_constraintBottom_toTopOf="@id/forum_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/forum_name"
        app:layout_constraintTop_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/forums"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:maxLines="2"
        android:textSize="26sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/forum_info_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        android:background="@drawable/card_white_translucent"
        app:cardCornerRadius="@dimen/border_radius"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/forum_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/text_view_errors">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/forum_owner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forum_created_by"
                android:textAlignment="center"
                android:textColor="@color/text_on_card_tertiary"
                android:textSize="12sp"
                android:textStyle="italic" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#44FFFFFF" />

            <TextView
                android:id="@+id/forum_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textAlignment="center"
                android:textColor="@color/text_on_card_primary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_view_errors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="6dp"
        android:background="@drawable/card_red"
        android:padding="10dp"
        android:text="@string/errors"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/forum_info_card"
        android:visibility="gone"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:paddingBottom="8dp"
        android:background="@drawable/card_purple"
        app:layout_constraintBottom_toTopOf="@id/comment_section"
        app:layout_constraintTop_toBottomOf="@id/text_view_errors" />

    <LinearLayout
        android:id="@+id/comment_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/recyclerView"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            style="@style/CRIApp.EditText"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:id="@+id/text_comment"
            android:layout_height="50dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/hint_comment"
            android:background="@drawable/edit_text" />

        <ImageButton
            android:id="@+id/comment_button"
            android:background="@drawable/ic_check"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="0dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>