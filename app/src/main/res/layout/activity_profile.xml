<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_purple_to_holo_purple_background"
    tools:context=".ProfileActivity">

    <ImageView
        android:id="@+id/imageProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/profile"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/profileScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageProfile" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/card_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleProfile">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="20dp"
            android:paddingEnd="10dp"
            android:paddingBottom="20dp">


            <TextView
                android:id="@+id/text_view_errors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="10dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:padding="10dp"
                android:text="@string/errors"
                android:background="@drawable/card_red"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/label_edit_text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/name"
                android:textColor="@color/white" />

            <EditText
                style="@style/CRIApp.EditText"
                android:id="@+id/edit_text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_full_name"
                android:inputType="textPersonName"
                />

            <TextView
                android:id="@+id/label_edit_text_birth_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/birth_date"
                android:textColor="@color/white" />

            <EditText
                style="@style/CRIApp.EditText"
                android:id="@+id/edit_text_birth_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:hint="@string/hint_birth_date"
                android:inputType="text"
                android:onClick="showDatePickerForBirthDate" />

            <TextView
                android:id="@+id/label_spinner_sex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sex"
                android:textColor="@color/white" />

            <com.example.criapp.CriAppDropdown
                style="@style/CRIApp.Dropdown"
                android:id="@+id/spinner_sex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/label_spinner_educational_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/educational_level"
                android:textColor="@color/white" />

            <com.example.criapp.CriAppDropdown
                style="@style/CRIApp.Dropdown"
                android:id="@+id/spinner_educational_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/label_spinner_family_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/family_type"
                android:textColor="@color/white" />

            <com.example.criapp.CriAppDropdown
                style="@style/CRIApp.Dropdown"
                android:id="@+id/spinner_family_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/label_edit_text_number_of_children"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/number_of_children"
                android:textColor="@color/white" />

            <EditText
                style="@style/CRIApp.EditText"
                android:id="@+id/edit_text_number_of_children"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_number_of_children"
                android:inputType="number" />

            <Button
                android:id="@+id/button_update_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="@string/ok"
                android:textColor="@color/white"
                android:backgroundTint="@color/dark_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:shapeAppearance="@style/CRIApp.RoundedCorner" />
            <Button
                android:id="@+id/deactivate_account_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/btn_destructive"
                android:text="@string/deactivate_account"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:shapeAppearance="@style/CRIApp.RoundedCorner"/>
            <Button
                android:id="@+id/button_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/btn_destructive"
                android:text="@string/logoff"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:onClick="onButtonLogoffClick"
                app:shapeAppearance="@style/CRIApp.RoundedCorner"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>