<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_purple_to_holo_purple_background">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_dev_tools" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="Dev Tools"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_purple"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

            <!-- SECTION: Loaders -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loaders"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:textColor="@color/text_on_card_tertiary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnShowLoader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Loading Dialog (3s)"
                android:backgroundTint="@color/dark_blue"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:shapeAppearance="@style/CRIApp.RoundedCorner" />

            <!-- SECTION: Banners -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Banners"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:textColor="@color/text_on_card_tertiary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnBannerSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Success Banner"
                android:backgroundTint="@color/green"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:shapeAppearance="@style/CRIApp.RoundedCorner" />

            <Button
                android:id="@+id/btnBannerError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Error Banner"
                android:backgroundTint="@color/red"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:shapeAppearance="@style/CRIApp.RoundedCorner" />

            <Button
                android:id="@+id/btnBannerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Info Banner"
                android:backgroundTint="@color/warning"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:shapeAppearance="@style/CRIApp.RoundedCorner" />

            <!-- SECTION: Preferences -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferences"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:textColor="@color/text_on_card_tertiary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPrefs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_holo_purple"
                android:padding="16dp"
                android:textColor="@color/text_on_card_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
