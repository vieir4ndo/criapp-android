<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CRIApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorAccent">@color/purple</item>
        <item name="colorSecondary">@color/dark_blue</item>
        <item name="colorPrimary">@color/light_blue</item>
        <item name="android:statusBarColor">#1E1030</item>
        <item name="android:navigationBarColor">#1E1030</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Dark surface tokens -->
        <item name="colorSurface">#1A0D2E</item>
        <item name="colorOnSurface">#F0EEFF</item>
        <item name="colorSurfaceVariant">#2B1A40</item>
        <item name="colorOnSurfaceVariant">#C8BFDD</item>
        <item name="colorOnBackground">#F0EEFF</item>
        <item name="android:windowBackground">#120921</item>

        <!-- Botões Material -->
        <item name="materialButtonStyle">@style/CRIApp.Button.Night</item>

        <!-- Evitar flash branco no arranque -->
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="CRIApp.Button.Night" parent="Widget.Material3.Button">
        <item name="backgroundTint">#2B1A40</item>
        <item name="android:textColor">#F0EEFF</item>
    </style>

    <style name="Theme.CRIApp.Anonymous" parent="Theme.CRIApp">
        <item name="android:navigationBarColor">#0D1B2A</item>
    </style>

    <style name="CRIApp" />

    <style name="CRIApp.EditText">
        <item name="android:background">@drawable/edit_text</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">#F0EEFF</item>
        <item name="android:textColorHint">#88C8BFDD</item>
    </style>

    <style name="CRIApp.PasswordField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#1E1030</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="shapeAppearance">@style/CRIApp.RoundedCorner</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="CRIApp.RoundedCorner">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="CRIApp.Spinner">
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:popupBackground">@drawable/spinner_popup_background</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>

    <style name="CRIApp.Dropdown">
        <item name="android:background">@drawable/edit_text</item>
        <item name="android:drawableEnd">@drawable/ic_spinner_arrow</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CRIApp_DatePickerDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorAccent">@color/purple</item>
        <item name="android:windowBackground">#1A0D2E</item>
        <item name="android:colorBackground">#1A0D2E</item>
        <item name="colorSurface">#1A0D2E</item>
        <item name="colorOnSurface">#F0EEFF</item>
    </style>

    <style name="CRIApp_MaterialDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorSurface">#1A0D2E</item>
        <item name="android:colorBackground">#1A0D2E</item>
        <item name="colorOnSurface">#F0EEFF</item>
        <item name="colorOnSurfaceVariant">#C8BFDD</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>
    </style>
</resources>